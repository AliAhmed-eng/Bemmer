@page "/"

<PageTitle>BMW — Sheer Driving Pleasure</PageTitle>

<div id="top">

    <section class="hero-section">

        <img src="/images/bmw-hero.jpg"
             alt="BMW-inspired luxury performance car"
             class="hero-image" />

        <div class="hero-overlay"></div>

        <div class="container-fluid hero-container">
            <div class="hero-content">

                <p class="hero-eyebrow">
                    THE ULTIMATE DRIVING EXPERIENCE
                </p>

                <h1>
                    Sheer Driving<br />
                    Pleasure.
                </h1>

                <p class="hero-description">
                    Discover a world of innovation, dynamic performance
                    and unmistakable automotive design.
                </p>

                <a href="#models" class="btn btn-light hero-button">
                    Discover the Models
                </a>

            </div>
        </div>

        <div class="hero-caption">
            A passion for driving. A vision for tomorrow.
        </div>

    </section>

    <section class="models-section py-5" id="models">

        <div class="container py-lg-4">

            <div class="section-heading text-center mb-5">
                <p class="section-eyebrow">EXPLORE THE RANGE</p>
                <h2 class="section-title">Discover BMW Models</h2>
                <p class="section-description">
                    Precision engineering meets distinctive design.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-12 col-md-6">

                    <article class="card feature-card h-100">

                        <img src="/images/bmw-3-series.jpg"
                             class="card-img-top model-image"
                             alt="BMW-inspired sports sedan" />

                        <div class="card-body">

                            <p class="model-category">SPORTS SEDAN</p>

                            <h3 class="card-title">
                                The Art of Performance
                            </h3>

                            <p class="card-text">
                                Experience a balanced combination of
                                dynamic handling, comfort and modern design.
                            </p>

                            <a href="#experience"
                               class="btn btn-outline-dark model-button">
                                Explore More
                            </a>

                        </div>

                    </article>

                </div>

                <div class="col-12 col-md-6">

                    <article class="card feature-card h-100">

                        <img src="/images/bmw-x5.jpg"
                             class="card-img-top model-image"
                             alt="BMW-inspired luxury SUV" />

                        <div class="card-body">

                            <p class="model-category">LUXURY SUV</p>

                            <h3 class="card-title">
                                Power Meets Elegance
                            </h3>

                            <p class="card-text">
                                Explore a confident driving experience
                                with spacious comfort and bold styling.
                            </p>

                            <a href="#experience"
                               class="btn btn-outline-dark model-button">
                                Explore More
                            </a>

                        </div>

                    </article>

                </div>

            </div>

        </div>

    </section>

    <section class="electric-section" id="electric">

        <div class="row g-0 align-items-center">

            <div class="col-12 col-lg-6">
                <img src="/images/bmw-electric.jpg"
                     class="electric-image"
                     alt="BMW-inspired electric vehicle" />
            </div>

            <div class="col-12 col-lg-6">

                <div class="electric-content">

                    <p class="section-eyebrow">
                        THE FUTURE OF MOBILITY
                    </p>

                    <h2 class="section-title">
                        A New Era of Electric Driving
                    </h2>

                    <p>
                        Discover a modern approach to mobility,
                        combining forward-thinking design with
                        an engaging driving experience.
                    </p>

                    <a href="#experience"
                       class="btn btn-dark electric-button">
                        Discover Electric Mobility
                    </a>

                </div>

            </div>

        </div>

    </section>

    <section class="experience-section py-5" id="experience">

        <div class="container py-lg-4">

            <div class="row g-4 align-items-center">

                <div class="col-12 col-lg-6">

                    <p class="section-eyebrow">
                        BEYOND THE ORDINARY
                    </p>

                    <h2 class="section-title">
                        Every Journey Tells a Story
                    </h2>

                    <p class="experience-description">
                        From open roads to breathtaking landscapes,
                        discover the feeling of driving through
                        a world full of possibilities.
                    </p>

                    <a href="#about" class="btn btn-dark experience-button">
                        Discover the Experience
                    </a>

                </div>

                <div class="col-12 col-lg-6">

                    <img src="/images/bmw-experience.jpg"
                         class="img-fluid experience-image"
                         alt="Scenic road and BMW-inspired driving experience" />

                </div>

            </div>

        </div>

    </section>

</div>
